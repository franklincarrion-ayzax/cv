    <!-- SCRIPT DE PESTAÑAS (INTERACTIVIDAD) -->
    <script>
        function switchTab(tabId) {
            // Ocultar todas las secciones
            document.querySelectorAll('.page-section').forEach(sec => {
                sec.classList.remove('active');
            });

            // Desactivar todos los botones
            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.className = "nav-btn px-3 sm:px-5 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-300 flex items-center space-x-2 text-purple-300 hover:text-white hover:bg-purple-950/50";
            });

            // Mostrar la sección seleccionada
            document.getElementById('sec-' + tabId).classList.add('active');

            // Activar el botón correspondiente
            const activeBtn = document.getElementById('btn-' + tabId);
            activeBtn.className = "nav-btn px-3 sm:px-5 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-300 flex items-center space-x-2 bg-purple-700 text-white shadow-md shadow-purple-900/40";
